<Window x:Class="Odyssey.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:avalonia="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
        xmlns:ids="using:Dock.Settings"
        xmlns:vm="using:Odyssey.ViewModels"
        xmlns:views="using:Odyssey.Views"
        mc:Ignorable="d"
        d:DesignWidth="1200" d:DesignHeight="680"
        x:Name="MainWindowView"
		x:DataType="vm:MainWindowViewModel"
		x:CompileBindings="True"
        UseLayoutRounding="True"
		RenderOptions.BitmapInterpolationMode="HighQuality"
        WindowState="Normal"
		WindowStartupLocation="CenterScreen"
        Background="{x:Null}"
        TransparencyLevelHint="AcrylicBlur"
        BorderThickness="1"
        FontFamily="Segoe UI, SF Pro Display, Noto Sans, Cantarel"
        Title="{Binding WindowTitle}"
		Height="680"
		Width="1200"
        ExtendClientAreaToDecorationsHint="True"
        ids:DockProperties.IsDragEnabled="True"
		ids:DockProperties.IsDropEnabled="True">
  <!-- Avalonia 12:
  ExtendClientAreaChromeHints are removed because they didn't work properly with newer OSes anyway.
  So ExtendClientAreaChromeHints="PreferSystemChrome" removed
  -->
  <Window.Resources>
    <ExperimentalAcrylicMaterial 
		BackgroundSource="Digger"
        TintColor="{DynamicResource AcrylicTintColor}"
		FallbackColor="{DynamicResource AcrylicFallbackColor}"
        TintOpacity="1"
        MaterialOpacity="0.55"
        x:Key="AcrylicMaterial"
	/>
  </Window.Resources>
  <Window.KeyBindings>
	<KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFileCommand}" />
	<KeyBinding Gesture="Ctrl+S" Command="{Binding SaveFileCommand}" />
	<KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveFileAsCommand}" />
	<KeyBinding Gesture="Ctrl+F4" Command="{Binding CloseFileCommand}" />
	<KeyBinding Gesture="Alt+F4" Command="{Binding ExitCommand}" />
	<KeyBinding Gesture="Ctrl+Home" Command="{Binding Layout.Navigate}" CommandParameter="Workspace" />
	<KeyBinding Gesture="F8" Command="{Binding CenterMapOnSelectedRegionCommand}" />
	<KeyBinding Gesture="Ctrl+F8" Command="{Binding CenterMapGloballyCommand}" />
	<KeyBinding Gesture="Ctrl+Shift+R" Command="{Binding ToggleAllShipRoutesCommand}" />
	<KeyBinding Gesture="F11" Command="{Binding ToggleFullscreenCommand}" />
	<KeyBinding Gesture="Ctrl+D1" Command="{Binding ToggleViewCommand}" CommandParameter="map" />
	<KeyBinding Gesture="Ctrl+D2" Command="{Binding ToggleViewCommand}" CommandParameter="minimap" />
	<KeyBinding Gesture="Ctrl+D3" Command="{Binding ToggleViewCommand}" CommandParameter="history" />
	<KeyBinding Gesture="Ctrl+D4" Command="{Binding ToggleViewCommand}" CommandParameter="bookmarks" />
	<KeyBinding Gesture="Ctrl+D5" Command="{Binding ToggleViewCommand}" CommandParameter="region_info" />
	<KeyBinding Gesture="Ctrl+D6" Command="{Binding ToggleViewCommand}" CommandParameter="battles" />
	<KeyBinding Gesture="Ctrl+D7" Command="{Binding ToggleViewCommand}" CommandParameter="search_results" />
	<KeyBinding Gesture="Ctrl+D8" Command="{Binding ToggleViewCommand}" CommandParameter="report_info" />
	<KeyBinding Gesture="Ctrl+D9" Command="{Binding ToggleViewCommand}" CommandParameter="error_list" />
	<KeyBinding Gesture="Ctrl+D0" Command="{Binding ToggleViewCommand}" CommandParameter="details" />
	<KeyBinding Gesture="Ctrl+Shift+D1" Command="{Binding ToggleViewCommand}" CommandParameter="region_statistics" />
	<KeyBinding Gesture="Ctrl+Shift+D2" Command="{Binding ToggleViewCommand}" CommandParameter="unit_orders" />
	<KeyBinding Gesture="Ctrl+Shift+D3" Command="{Binding ToggleViewCommand}" CommandParameter="region_properties" />
	<KeyBinding Gesture="Ctrl+Shift+D4" Command="{Binding ToggleViewCommand}" CommandParameter="explorer" />
	<KeyBinding Gesture="F2" Command="{Binding BookmarksViewModel.JumpToNextBookmarkCommand}" />
	<KeyBinding Gesture="Shift+F2" Command="{Binding BookmarksViewModel.JumpToPreviousBookmarkCommand}" />
	<KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding NavigateToAdvancedSearchCommand}" />
	<KeyBinding Gesture="Ctrl+," Command="{Binding Layout.Navigate}" CommandParameter="Configuration" />
	<KeyBinding Gesture="F1" Command="{Binding ShowHelpCommand}" />
  </Window.KeyBindings>
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>
	<DockPanel>
	<!-- Customized top bar if I want to add window title in it-->
		<!--Border
    x:Name="TopBar"
    Background="{DynamicResource DockThemeBackgroundBrush}"
    DockPanel.Dock="Top"
    Height="30">
    <Grid>
        <TextBlock
            Text="{Binding WindowTitle}"
            VerticalAlignment="Center"
            HorizontalAlignment="Left"
            Margin="5,0,0,0"
            FontWeight="Bold"
            FontSize="12"/>
    </Grid>
</Border-->
  <Panel>
	<ExperimentalAcrylicBorder IsHitTestVisible="False" Material="{StaticResource AcrylicMaterial}" />
    <Panel Margin="{Binding #MainWindowView.OffScreenMargin}">
		<!--Panel Margin="5"-->
		<!-- this WindowDecorationMargin Avalonia.Dock property seems to be too big. What is its usage? -->
	  <Panel Margin="{Binding #MainWindowView.WindowDecorationMargin}">
        <views:MainView>
          <views:MainView.Styles>
            <Style Selector="GridSplitter">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate>
                    <Border Background="Transparent">
						<ExperimentalAcrylicBorder Material="{StaticResource AcrylicMaterial}" />
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </views:MainView.Styles>
        </views:MainView>
      </Panel>
    </Panel>
  </Panel>
		</DockPanel>
</Window>
