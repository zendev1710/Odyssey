<UserControl x:Class="Odyssey.Views.BuildingsDetailsView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:Odyssey.ViewModels"
             xmlns:controls="using:Odyssey.Controls"
             mc:Ignorable="d"
             d:DesignWidth="300" d:DesignHeight="400"
             x:DataType="vm:BuildingsDetailsViewModel" x:CompileBindings="True">
	<Design.DataContext>
		<vm:BuildingsDetailsViewModel />
	</Design.DataContext>
	<Grid Focusable="True" IsVisible="{Binding HasDocument}">
		<controls:StructuresListControl />
	</Grid>
</UserControl>
