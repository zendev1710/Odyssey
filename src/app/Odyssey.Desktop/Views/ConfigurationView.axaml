<UserControl x:Class="Odyssey.Views.ConfigurationView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ConfigFactory.Avalonia;assembly=ConfigFactory.Avalonia"
        xmlns:vm="using:Odyssey.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DesignHeight="450"
        d:DesignWidth="800"
        mc:Ignorable="d" x:DataType="vm:ConfigurationViewModel">
    <UserControl.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="SystemChromeLowColor" Color="{DynamicResource ApplicationThemeBackgroundColor}" />
            <SolidColorBrush x:Key="SystemChromeHighColor" Color="{DynamicResource ApplicationThemeForegroundColor}" />
            <SolidColorBrush x:Key="SystemChromeMediumColor" Color="{DynamicResource ApplicationThemeSurfaceColor}" />
            <SolidColorBrush x:Key="SystemChromeMediumLowColor" Color="{DynamicResource ApplicationConfigItemHoverColor}" />
        </ResourceDictionary>
    </UserControl.Resources>
    <controls:ConfigPage Name="ConfigPage" />
</UserControl>
