<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Odyssey.Help.HelpWindow"
        Width="1200"
		Height="800"
        MinWidth="900"
		MinHeight="600"
        WindowStartupLocation="CenterOwner"
>

    <Grid RowDefinitions="Auto,*">
        
        <!-- Header -->
		<!---->
        <Border Grid.Row="0" Background="{DynamicResource SystemAccentColor}" Padding="16">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="📚" FontSize="24" VerticalAlignment="Center" />
                    <TextBlock Text="Help Center" FontSize="18" FontWeight="Bold" 
                               Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="LanguageComboBox" 
                              MinWidth="120"
                              SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem Content="🇺🇸 English" Tag="en" />
                        <ComboBoxItem Content="🇫🇷 Français" Tag="fr" />
                        <ComboBoxItem Content="🇩🇪 Deutsch" Tag="de" />
                        <ComboBoxItem Content="🇪🇸 Español" Tag="es" />
                    </ComboBox>

					<Button x:Name="RefreshButton" Content="🔄" 
                            ToolTip.Tip="Refresh content"
                            Click="OnRefreshClicked" />
                </StackPanel>
            </Grid>
        </Border>
		<!---->

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="300,*">
            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer>
                    <StackPanel Margin="16">
                        <TextBlock Text="Topics" FontWeight="Bold" FontSize="16" Margin="0,0,0,12" />
						<!-- CGN PBM HERE -->
						<!--
                        <ListBox x:Name="TopicsListBox" 
                                 Background="Transparent"
                                 SelectionChanged="OnTopicSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" 
                                                Margin="8,4">
										<TextBlock Text="ICON" FontSize="16" />
										<TextBlock Text="TITLE" TextWrapping="Wrap" /> -->
										<!-- CGN FIXME - NO DATACONTEXT -->
										<!--
                                        <TextBlock Text="{Binding Icon}" FontSize="16" />
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
										-->
						<!--

                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
						-->
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- WebView Content Area -->
            <Grid Grid.Column="1">
                <!-- WebView pour afficher le contenu HTML -->
				<!-- CGN PBM HERE -->
				<!--WebView x:Name="ContentWebView" /-->
                <!-- Loading indicator -->
                <Grid x:Name="LoadingGrid" IsVisible="False" 
                      Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="200" Margin="0,0,0,16" />
                        <TextBlock Text="Loading content..." HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <!-- Error message -->
                <Grid x:Name="ErrorGrid" IsVisible="False" 
                      Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                        <TextBlock Text="⚠️" FontSize="48" HorizontalAlignment="Center" />
                        <TextBlock x:Name="ErrorMessage" Text="Could not load content" 
                                   HorizontalAlignment="Center" FontSize="16" />
                        <Button Content="Retry" Click="OnRetryClicked" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
