<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:Odyssey.ViewModels.Tools"
			 xmlns:a="clr-namespace:Odyssey.Assets"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="250"
			 x:DataType="vm:HistoryViewModel" x:CompileBindings="True"
             x:Class="Odyssey.Views.Tools.HistoryView">
	<Grid Focusable="True" IsVisible="{Binding HasDocument}" >
		<ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoScrollToSelectedItem="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
	</Grid>
</UserControl>
