<UserControl x:Class="Odyssey.Views.Tools.RegionInfoView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:Odyssey.ViewModels.Tools"
             mc:Ignorable="d"
             d:DesignWidth="300" d:DesignHeight="400"
             x:DataType="vm:RegionInfoViewModel"
			 x:CompileBindings="True">
	<Grid Focusable="True" IsVisible="{Binding HasDocument}">
		<TreeView ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" DoubleTapped="TreeView_DoubleTapped" >
			<TreeView.ItemTemplate>
				<TreeDataTemplate ItemsSource="{Binding Children}">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="{Binding Header}" />
					</StackPanel>
				</TreeDataTemplate>
			</TreeView.ItemTemplate>
		</TreeView>
	</Grid>
</UserControl>
