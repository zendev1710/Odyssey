<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:Odyssey.Controls"
             xmlns:vm="using:Odyssey.ViewModels.Tools"
             xmlns:vmtools="using:Odyssey.ViewModels.Tools"
             x:Class="Odyssey.Views.Tools.UnitStripView"
             x:Name="Root"
             x:DataType="vm:UnitStripViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450">
    <Border Padding="6" Background="{DynamicResource PanelBackground}">
        <ScrollViewer Name="UnitsScrollViewer"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Units}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="0" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vmtools:UnitViewModel">
                        <Border Height="100" ClipToBounds="True">
                            <Grid ColumnSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="{Binding DataContext.OrdersColumnWidth, ElementName=Root}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                        Padding="4"
                                        BorderBrush="#FF555555"
                                        BorderThickness="1">
                                    <Button Width="160"
                                            Height="52"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Padding="0"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            Command="{Binding DataContext.SelectUnitCommand, ElementName=Root}"
                                            CommandParameter="{Binding}">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Opacity" Value="0.85" />
                                            </Style>
                                        </Button.Styles>
                                        <Border Width="160"
                                                Padding="6"
                                                HorizontalAlignment="Center"
                                                CornerRadius="12"
                                                BorderBrush="{Binding FactionStatusBrush}"
                                                BorderThickness="4"
                                                Background="{Binding IdentityBackground}">
                                            <Grid ColumnDefinitions="*,42">
                                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding IdentityForeground}"
                                                               TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Id}"
                                                               FontSize="10"
                                                               Foreground="{Binding IdentityForeground}"
                                                               TextWrapping="NoWrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PeopleNumber}"
                                                               FontSize="20"
                                                               FontWeight="Black"
                                                               Foreground="{Binding IdentityForeground}"
                                                               TextAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </Border>
                                <Border Grid.Column="1"
                                        Padding="4"
                                        BorderBrush="#FF555555"
                                        BorderThickness="1">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding OrdersSummary}"
                                                   TextWrapping="NoWrap" />
                                    </ScrollViewer>
                                </Border>
                                <Border Grid.Column="2"
                                        Padding="3"
                                        BorderBrush="#FF555555"
                                        BorderThickness="1">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <Grid RowDefinitions="Auto,Auto" RowSpacing="4" VerticalAlignment="Center">
                                            <Border Grid.Row="0" Background="#4a4742" CornerRadius="5">
                                                <ItemsControl ItemsSource="{Binding InventoryItems}" VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="2" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vmtools:UnitItemViewModel">
                                                            <controls:UnitItemBadgeControl DataContext="{Binding}" Zoom="0.8" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                            <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="5" IsVisible="{Binding AreSkillsVisible}">
                                                <ItemsControl ItemsSource="{Binding SkillItems}" VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="2" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vmtools:UnitSkillViewModel">
                                                            <controls:UnitSkillBadgeControl DataContext="{Binding}" Zoom="0.8" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </Grid>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</UserControl>
