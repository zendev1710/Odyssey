<UserControl x:Class="Odyssey.Views.Tools.UnitOrdersView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:AvalonEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:vmt="using:Odyssey.ViewModels.Tools"
			 xmlns:vm="using:Odyssey.ViewModels"
			 xmlns:views="using:Odyssey.Views"
			 xmlns:a="clr-namespace:Odyssey.Assets"
             mc:Ignorable="d"
             d:DesignWidth="300" d:DesignHeight="400"
             x:DataType="vmt:UnitOrdersViewModel"
			 x:CompileBindings="True"
		>
	<Grid Name="UnitOrders" Focusable="True" IsVisible="true" RowDefinitions="*,Auto" ColumnDefinitions="*,Auto">
		<AvalonEdit:TextEditor 
			Name="TextEditor"
			Grid.Row="0"
			FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
			HorizontalScrollBarVisibility="Auto"
			VerticalScrollBarVisibility="Visible"
			FontWeight="Light"
			FontSize="14"
			IsEnabled="True"
			IsVisible="True"
			ShowLineNumbers="True"
			Document="{Binding Document}"
			>
		</AvalonEdit:TextEditor>
		<Grid Name="StatusBar" Grid.Row="1" >
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<StackPanel Grid.Column="0" Margin="5,0,2,2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
				<CheckBox IsChecked="{Binding IsConfirmed, Mode=TwoWay}" IsEnabled="{Binding CanEditOrders}" Command="{Binding ToggleConfirmedStatusCommand}" Content="{x:Static a:Lang.opt_confirmed_orders}" ToolTip.Tip="{x:Static a:Lang.opt_confirmed_orders_tip}" Margin="5 0 10 0" FontSize="12" />
				<Button Content="{x:Static a:Lang.btn_previous_unit}" ToolTip.Tip="{x:Static a:Lang.btn_previous_unit_tip}" Margin="5 0 0 0" FontSize="12" Command="{Binding SelectPreviousUnitCommand}" />
				<Button Content="{x:Static a:Lang.btn_next_unit}" ToolTip.Tip="{x:Static a:Lang.btn_next_unit_tip}" Margin="5 0 0 0" FontSize="12" Command="{Binding SelectNextUnitCommand}" />
			</StackPanel>
			<!--StackPanel Grid.Column="2" Margin="5,0,2,2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" -->
				<!--TextBlock Name="StatusText" Text="Ready" Margin="5 0 0 0" FontSize="12" /-->
				<!--TextBlock Name="StatusUnitName" Text="{Binding UnitName}" Margin="5 0 0 0" FontSize="12" /-->
			<!--/StackPanel-->
		</Grid>
	</Grid>
</UserControl>

