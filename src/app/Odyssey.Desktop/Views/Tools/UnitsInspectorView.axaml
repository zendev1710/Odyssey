<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="using:Odyssey.Controls"
             xmlns:conv="using:Odyssey.Converters"
             xmlns:vm="using:Odyssey.ViewModels.Tools"
             x:Class="Odyssey.Views.Tools.UnitsInspectorView"
             x:Name="Root"
             x:DataType="vm:UnitsInspectorViewModel"
             x:CompileBindings="False"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="700">
    <UserControl.Resources>
        <conv:IconPathToImageConverter x:Key="IconPathToImageConverter" />
        <DataTemplate x:Key="UnitIdentityTemplate" x:DataType="vm:UnitViewModel">
            <Button Width="160" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="0" BorderThickness="0" Background="Transparent"
                    Command="{Binding DataContext.SelectUnitCommand, ElementName=Root}"
                    CommandParameter="{Binding}">
                <Button.Styles>
                    <Style Selector="Button:pointerover">
                        <Setter Property="Opacity" Value="0.85" />
                    </Style>
                </Button.Styles>
                <Border Width="160" Height="100" Padding="6" HorizontalAlignment="Center"
                        CornerRadius="12" BorderBrush="{Binding FactionStatusBrush}" BorderThickness="4"
                        Background="{DynamicResource ApplicationThemeSurfaceBrush}"
                        Classes.selected="{Binding IsSelected}">
                    <Border.Styles>
                        <Style Selector="Border.selected">
                            <Setter Property="Background" Value="{DynamicResource ApplicationThemeSelectionBrush}" />
                        </Style>
                    </Border.Styles>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto" Margin="1">
                        <Grid Grid.Column="0" Grid.RowSpan="2" RowDefinitions="*,Auto">
                            <StackPanel Grid.Row="0" Spacing="3" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           Classes="unit-badge-text" Classes.selected="{Binding IsSelected}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Id}" FontSize="10"
                                           Classes="unit-badge-text" Classes.selected="{Binding IsSelected}"
                                           TextWrapping="NoWrap" />
                            </StackPanel>
                            <Grid Grid.Row="1" Width="22" Height="22" Margin="1"
                                  HorizontalAlignment="Left" VerticalAlignment="Bottom">
                                <Border x:Name="CombatStatusThemeColors" Width="0" Height="0"
                                        Background="{DynamicResource ApplicationThemeSurfaceBrush}"
                                        Tag="{DynamicResource ApplicationThemeForegroundBrush}"
                                        Classes.selected="{Binding IsSelected}">
                                    <Border.Styles>
                                        <Style Selector="Border.selected">
                                            <Setter Property="Background" Value="{DynamicResource ApplicationThemeSelectionBrush}" />
                                            <Setter Property="Tag" Value="{DynamicResource ApplicationThemeSelectionForegroundBrush}" />
                                        </Style>
                                    </Border.Styles>
                                </Border>
                                <Image Width="20" Height="20" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding CombatStatusIconUri, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       ToolTip.Tip="{Binding CombatStatusTooltip}"
                                       Stretch="Uniform">
                                    <Image.Source>
                                        <MultiBinding Converter="{StaticResource IconPathToImageConverter}">
                                            <Binding Path="CombatStatusIconUri" />
                                            <Binding ElementName="CombatStatusThemeColors" Path="Background" />
                                            <Binding ElementName="CombatStatusThemeColors" Path="Tag" />
                                        </MultiBinding>
                                    </Image.Source>
                                </Image>
                            </Grid>
                        </Grid>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PeopleNumber}" FontSize="20"
                                   FontWeight="Black" Classes="unit-badge-text"
                                   Classes.selected="{Binding IsSelected}"
                                   TextAlignment="Right" HorizontalAlignment="Right"
                                   VerticalAlignment="Top" Margin="0,1,0,0" />
                        <Grid Grid.Row="1" Grid.Column="1" Width="22" Height="22" Margin="1"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Border x:Name="HealthStatusThemeColors" Width="0" Height="0"
                                    Background="{DynamicResource ApplicationThemeSurfaceBrush}"
                                    Tag="{DynamicResource ApplicationThemeForegroundBrush}"
                                    Classes.selected="{Binding IsSelected}">
                                <Border.Styles>
                                    <Style Selector="Border.selected">
                                        <Setter Property="Background" Value="{DynamicResource ApplicationThemeSelectionBrush}" />
                                        <Setter Property="Tag" Value="{DynamicResource ApplicationThemeSelectionForegroundBrush}" />
                                    </Style>
                                </Border.Styles>
                            </Border>
                            <Image Width="20" Height="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding HealthStatusIconUri, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   ToolTip.Tip="{Binding HealthStatusTooltip}"
                                   Stretch="Uniform">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource IconPathToImageConverter}">
                                        <Binding Path="HealthStatusIconUri" />
                                        <Binding ElementName="HealthStatusThemeColors" Path="Background" />
                                        <Binding ElementName="HealthStatusThemeColors" Path="Tag" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                        </Grid>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="UnitSkillsAndInventoryTemplate" x:DataType="vm:UnitViewModel">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="4" VerticalAlignment="Center">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding InventoryItems.Count}">
                    <RepeatButton Grid.Column="0" Content="◀" Width="24" Padding="0"
                                  VerticalAlignment="Center" IsVisible="False" />
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding InventoryItems}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:UnitItemViewModel">
                                    <controls:UnitItemBadgeControl DataContext="{Binding}" Zoom="0.8" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <RepeatButton Grid.Column="2" Content="▶" Width="24" Padding="0"
                                  VerticalAlignment="Center" IsVisible="False" />
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding AreSkillsVisible}">
                    <RepeatButton Grid.Column="0" Content="◀" Width="24" Padding="0"
                                  VerticalAlignment="Center" IsVisible="False" />
                    <ScrollViewer Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SkillItems}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:UnitSkillViewModel">
                                    <controls:UnitSkillBadgeControl DataContext="{Binding}" Zoom="0.8" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <RepeatButton Grid.Column="2" Content="▶" Width="24" Padding="0"
                                  VerticalAlignment="Center" IsVisible="False" />
                </Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="UnitOrdersTemplate" x:DataType="vm:UnitViewModel">
            <Border BorderBrush="{DynamicResource TextControlBorderBrush}" BorderThickness="1">
                <controls:UnitOrdersViewer OrdersText="{Binding OrdersSummary}"
                                           IsConfirmed="{Binding IsConfirmed}"
                                           CanEditOrders="{Binding CanEditOrders}" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="TextBlock.unit-badge-text">
            <Setter Property="Foreground" Value="{DynamicResource ApplicationThemeForegroundBrush}" />
        </Style>
        <Style Selector="TextBlock.unit-badge-text.selected">
            <Setter Property="Foreground" Value="{DynamicResource ApplicationThemeSelectionForegroundBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource PanelBackground}" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding LocatedFaction.Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LocatedFaction.Region.Name}" Foreground="#FF888888" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                <Button Content="⇤" Command="{Binding NavigateToFirstLocatedFactionCommand}" IsVisible="{Binding ShowFirstLastLocatedFactionButtons}" />
                <Button Content="←" Command="{Binding NavigateToPreviousLocatedFactionCommand}" />
                <Button Content="→" Command="{Binding NavigateToNextLocatedFactionCommand}" />
                <Button Content="⇥" Command="{Binding NavigateToLastLocatedFactionCommand}" IsVisible="{Binding ShowFirstLastLocatedFactionButtons}" />
            </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" x:Name="UnitsScrollViewer"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="UnitsGrid" ColumnSpacing="0" IsVisible="{Binding HasDocument}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="{Binding OrdersColumnWidth, Mode=TwoWay}" />
                </Grid.ColumnDefinitions>
                <GridSplitter x:Name="UnitsGridSplitter" Grid.Row="0" Grid.Column="0" Width="10"
                              HorizontalAlignment="Right" ResizeDirection="Columns"
                              ResizeBehavior="CurrentAndNext" ShowsPreview="False"
                              IsVisible="{Binding IsOrdersColumnVisible}" Cursor="SizeWestEast">
                    <GridSplitter.Template>
                        <ControlTemplate>
                            <Border Background="Transparent">
                                <Border x:Name="SplitterGrip" Width="1" HorizontalAlignment="Center"
                                        Background="{DynamicResource TextControlBorderBrushPointerOver}"
                                        Opacity="0" />
                            </Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                    <GridSplitter.Styles>
                        <Style Selector="GridSplitter:pointerover /template/ Border#SplitterGrip">
                            <Setter Property="Opacity" Value="1" />
                        </Style>
                        <Style Selector="GridSplitter:pressed /template/ Border#SplitterGrip">
                            <Setter Property="Opacity" Value="1" />
                        </Style>
                    </GridSplitter.Styles>
                </GridSplitter>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>