<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="using:Odyssey.Views.Tools"
             xmlns:vm="using:Odyssey.ViewModels.Tools"
             x:Class="Odyssey.Views.Tools.UnitsInspectorView"
             x:DataType="vm:UnitsInspectorViewModel"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="8" Background="{DynamicResource PanelBackgroundBrush}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LocatedFaction.Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding LocatedFaction.Region.Name}" Foreground="#FF888888" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <Button Content="⇤" Command="{Binding NavigateToFirstLocatedFactionCommand}" IsVisible="{Binding ShowFirstLastLocatedFactionButtons}" />
                    <Button Content="←" Command="{Binding NavigateToPreviousLocatedFactionCommand}" />
                    <Button Content="→" Command="{Binding NavigateToNextLocatedFactionCommand}" />
                    <Button Content="⇥" Command="{Binding NavigateToLastLocatedFactionCommand}" IsVisible="{Binding ShowFirstLastLocatedFactionButtons}" />
                </StackPanel>
            </Grid>
        </Border>
        <views:UnitStripView Grid.Row="1" DataContext="{Binding StripViewModel}" />
    </Grid>
</UserControl>