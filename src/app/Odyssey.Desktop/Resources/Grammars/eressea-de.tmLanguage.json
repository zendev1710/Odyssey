            { "include": "#comment-inline" }
          ]
        },
        {
          "begin": "^\\s*(@?)(?i:(SPRACHE))\\s+(?i:(DE))\\b",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.priority.eressea" },
            "2": { "name": "keyword.command.eressea.faction-order" }
          },
          "end": "$",
          "patterns": [
            {
              "match": "(?i)\\bDE\\b",
              "name": "constant.language.value.eressea"
            },
            { "include": "#comment-inline" }
          ]
        },
        {
          "begin": "^\\s*(@?)(?i:(LOCALE))\\s+(?i:(DE))\\b",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.priority.eressea" },
            "2": { "name": "keyword.command.eressea.faction-order" }
          },
          "end": "$",
          "patterns": [
            {
              "match": "(?i)\\bDE\\b",
              "name": "constant.language.value.eressea"
            },
            { "include": "#comment-inline" }
          ]
        },
        {
          "begin": "\\s*(@?)(?i:(OPTION))\\b",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.priority.eressea" },
            "2": { "name": "keyword.command.eressea.faction-order" }
          },
          "end": "$",
          "patterns": [
            {
              "match": "(?i:(ADRESSEN|COMPUTER|PLAINTEXT|SCORE|STATISTICS|TEMPLATE))\\b",
              "name": "constant.language.option.eressea"
