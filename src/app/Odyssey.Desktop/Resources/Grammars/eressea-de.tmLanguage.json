            {
              "begin": "\\b(?i:FACTION)\\b",
              "beginCaptures": {
                "0": { "name": "keyword.entity.eressea" }
              },
              "end": "(?=\\s|$)",
              "patterns": [
                { "include": "#element-id" }
              ]
            },
            { "include": "#comment-inline" }
          ]
        },
        {
          "begin": "^\\s*(@?)(?i:(REGION))\\b",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.priority.eressea" },
            "2": { "name": "keyword.command.eressea.meta-order" }
          },
          "end": "$",
          "patterns": [
            { "include": "#coords-comma" },
            { "include": "#comment-inline" }
