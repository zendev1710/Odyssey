    "meta-orders": {
      "patterns": [
        {
          "begin": "^\\s*(@?)(?i:(ERESSEA))\\b",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.priority.eressea" },
            "2": { "name": "keyword.command.eressea.meta-order" }
          },
          "end": "$",
          "patterns": [
            {
              "match": "\\bF\\d+\\b",
              "name": "constant.numeric.eressea.faction-id"
            },
            {
              "match": "\"[^\"]*\"",
              "name": "string.quoted.eressea.password"
            },
            { "include": "#comment-inline" }
          ]
        },
        {
          "begin": "^\\s*(@?)(?i:(NÄCHSTER))\\b",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.priority.eressea" },
            "2": { "name": "keyword.command.eressea.meta-order" }
          },
          "end": "$",
          "patterns": [
            { "include": "#comment-inline" }
          ]
        },
        {
          "begin": "\\s*(@?)(?i:(STIRB))\\b",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.priority.eressea" },
            "2": { "name": "keyword.command.eressea.meta-order" }
          },
          "end": "$",
          "patterns": [
            {
              "name": "string.quoted.password.eressea",
              "match": "\"[A-Za-z0-9]+\""
