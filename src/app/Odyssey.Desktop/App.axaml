<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Odyssey"
             xmlns:core="using:Dock.Model.Core"
             Name="Odyssey"
             x:Class="Odyssey.App">

	<Application.DataTemplates>
		<local:ViewLocator />
	</Application.DataTemplates>
	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<!--ResourceInclude Source="/Controls/BookmarkStyles.axaml"/-->
				<ResourceInclude Source="/Controls/StarStyles.axaml"/>
				<ResourceDictionary>
					<ControlRecycling x:Key="ControlRecyclingKey" />
				</ResourceDictionary>
				<ResourceDictionary>
					<ResourceDictionary.ThemeDictionaries>
						<ResourceDictionary x:Key='Default'>
							<!---->
							<SolidColorBrush x:Key="TextControlBackground">#EFEFEF</SolidColorBrush>
							<SolidColorBrush x:Key="TextControlBackgroundFocused">#EFEFEF</SolidColorBrush>
							<SolidColorBrush x:Key="TextControlBackgroundPointerOver">#EFEFEF</SolidColorBrush>
							<SolidColorBrush x:Key="TextControlForeground">#212121</SolidColorBrush>
							<SolidColorBrush x:Key="TextForegroundColor">#212121</SolidColorBrush>
							<SolidColorBrush x:Key="TextControlBorderBrush">#33323232</SolidColorBrush>
							<SolidColorBrush x:Key="TextControlBorderBrushPointerOver">#33323232</SolidColorBrush>
							<!---->
							<!-- GAME COLORS FOR LIGHT - BEGIN -->
							<!-- Specific colors -->
							<SolidColorBrush x:Key="UnitInShipForegroundColor">#8B0000</SolidColorBrush>
							<SolidColorBrush x:Key="UnitInBuildingForegroundColor">#008B8B</SolidColorBrush>
							<SolidColorBrush x:Key="ShipInNotActiveFactionForegroundColor">#008000</SolidColorBrush>
							<SolidColorBrush x:Key="BuildingInNotActiveFactionForegroundColor">#696969</SolidColorBrush>
							<SolidColorBrush x:Key="RegionRareItemForegroundColor">#BE721B</SolidColorBrush>
							<!-- Background colors for terrains -->
							<SolidColorBrush x:Key="UnknownTerrainBackgroundColor">#222222</SolidColorBrush>
							<SolidColorBrush x:Key="OceanTerrainBackgroundColor">#5264d6</SolidColorBrush>
							<SolidColorBrush x:Key="SwampTerrainBackgroundColor">#19332a</SolidColorBrush>
							<SolidColorBrush x:Key="PlainsTerrainBackgroundColor">#defcae</SolidColorBrush>
							<SolidColorBrush x:Key="DesertTerrainBackgroundColor">#f4c354</SolidColorBrush>
							<SolidColorBrush x:Key="ForestTerrainBackgroundColor">#72ba66</SolidColorBrush>
							<SolidColorBrush x:Key="HighlandTerrainBackgroundColor">#e8c98e</SolidColorBrush>
							<SolidColorBrush x:Key="MountainTerrainBackgroundColor">#8c8683</SolidColorBrush>
							<SolidColorBrush x:Key="GlacierTerrainBackgroundColor">#ebebeb</SolidColorBrush>
							<!-- GAME COLORS FOR LIGHT - END -->
							<Color x:Key="RegionColor">#FFFAFAFA</Color>
							<Color x:Key="AcrylicFallbackColor">#E2E2E2</Color>
							<Color x:Key="AcrylicTintColor">#FFFFFF</Color>
						</ResourceDictionary>
						<ResourceDictionary x:Key='Light'>
							<!---->
							<SolidColorBrush x:Key="TextControlBackground">#EFEFEF</SolidColorBrush>
							<SolidColorBrush x:Key="TextControlBackgroundFocused">#EFEFEF</SolidColorBrush>
							<SolidColorBrush x:Key="TextControlBackgroundPointerOver">#EFEFEF</SolidColorBrush>
							<SolidColorBrush x:Key="TextControlForeground">#212121</SolidColorBrush>
							<SolidColorBrush x:Key="TextForegroundColor">#212121</SolidColorBrush>
							<SolidColorBrush x:Key="TextControlBorderBrush">#33323232</SolidColorBrush>
							<SolidColorBrush x:Key="TextControlBorderBrushPointerOver">#33323232</SolidColorBrush>
							<!---->
							<!-- GAME COLORS FOR LIGHT - BEGIN -->
							<!-- Specific colors -->
							<SolidColorBrush x:Key="UnitInShipForegroundColor">#8B0000</SolidColorBrush>
							<SolidColorBrush x:Key="UnitInBuildingForegroundColor">#008B8B</SolidColorBrush>
							<SolidColorBrush x:Key="ShipInNotActiveFactionForegroundColor">#008000</SolidColorBrush>
							<SolidColorBrush x:Key="BuildingInNotActiveFactionForegroundColor">#696969</SolidColorBrush>
							<SolidColorBrush x:Key="RegionRareItemForegroundColor">#BE721B</SolidColorBrush>
							<!-- Background colors for terrains -->
							<SolidColorBrush x:Key="UnknownTerrainBackgroundColor">#222222</SolidColorBrush>
							<SolidColorBrush x:Key="OceanTerrainBackgroundColor">#5264d6</SolidColorBrush>
							<SolidColorBrush x:Key="SwampTerrainBackgroundColor">#19332a</SolidColorBrush>
							<SolidColorBrush x:Key="PlainsTerrainBackgroundColor">#defcae</SolidColorBrush>
							<SolidColorBrush x:Key="DesertTerrainBackgroundColor">#f4c354</SolidColorBrush>
							<SolidColorBrush x:Key="ForestTerrainBackgroundColor">#72ba66</SolidColorBrush>
							<SolidColorBrush x:Key="HighlandTerrainBackgroundColor">#e8c98e</SolidColorBrush>
							<SolidColorBrush x:Key="MountainTerrainBackgroundColor">#8c8683</SolidColorBrush>
							<SolidColorBrush x:Key="GlacierTerrainBackgroundColor">#ebebeb</SolidColorBrush>
							<!-- GAME COLORS FOR LIGHT - END -->
							<Color x:Key="RegionColor">#FFFAFAFA</Color>
							<Color x:Key="AcrylicFallbackColor">#E2E2E2</Color>
							<Color x:Key="AcrylicTintColor">#FFFFFF</Color>
						</ResourceDictionary>
						<ResourceDictionary x:Key='Dark'>
							<!---->
							<SolidColorBrush x:Key="TextControlBackground">#2F2F2F</SolidColorBrush>
							<SolidColorBrush x:Key="TextControlBackgroundFocused">#2F2F2F</SolidColorBrush>
							<SolidColorBrush x:Key="TextControlBackgroundPointerOver">#2F2F2F</SolidColorBrush>
							<SolidColorBrush x:Key="TextControlForeground">#FFFFFF</SolidColorBrush>
							<SolidColorBrush x:Key="TextForegroundColor">#FFFFFF</SolidColorBrush>
							<SolidColorBrush x:Key="TextControlBorderBrush">#434343</SolidColorBrush>
							<SolidColorBrush x:Key="TextControlBorderBrushPointerOver">#434343</SolidColorBrush>
							<!---->
							<!-- GAME COLORS FOR DARK - BEGIN -->
							<!-- Specific colors -->
							<SolidColorBrush x:Key="UnitInShipForegroundColor">#8B0000</SolidColorBrush>
							<SolidColorBrush x:Key="UnitInBuildingForegroundColor">#008B8B</SolidColorBrush>
							<SolidColorBrush x:Key="ShipInNotActiveFactionForegroundColor">#008000</SolidColorBrush>
							<SolidColorBrush x:Key="BuildingInNotActiveFactionForegroundColor">#696969</SolidColorBrush>
							<SolidColorBrush x:Key="RegionRareItemForegroundColor">#FF9800</SolidColorBrush>
							<!-- Background colors for terrains -->
							<SolidColorBrush x:Key="UnknownTerrainBackgroundColor">#222222</SolidColorBrush>
							<SolidColorBrush x:Key="OceanTerrainBackgroundColor">#5264d6</SolidColorBrush>
							<SolidColorBrush x:Key="SwampTerrainBackgroundColor">#19332a</SolidColorBrush>
							<SolidColorBrush x:Key="PlainsTerrainBackgroundColor">#defcae</SolidColorBrush>
							<SolidColorBrush x:Key="DesertTerrainBackgroundColor">#f4c354</SolidColorBrush>
							<SolidColorBrush x:Key="ForestTerrainBackgroundColor">#72ba66</SolidColorBrush>
							<SolidColorBrush x:Key="HighlandTerrainBackgroundColor">#e8c98e</SolidColorBrush>
							<SolidColorBrush x:Key="MountainTerrainBackgroundColor">#8c8683</SolidColorBrush>
							<SolidColorBrush x:Key="GlacierTerrainBackgroundColor">#ebebeb</SolidColorBrush>
							<!-- GAME COLORS FOR DARK - END -->
							<Color x:Key="RegionColor">#FF212121</Color>
							<Color x:Key="AcrylicFallbackColor">#1F1F1F</Color>
							<Color x:Key="AcrylicTintColor">#2F2F2F</Color>
						</ResourceDictionary>
					</ResourceDictionary.ThemeDictionaries>
				</ResourceDictionary>
			</ResourceDictionary.MergedDictionaries>
			<!-- Styles attached dynamically depending on current theme (simple or fluent) -->
			<StyleInclude x:Key="AvaloniaEditFluent" Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
			<StyleInclude x:Key="AvaloniaEditSimple" Source="avares://AvaloniaEdit/Themes/Simple/AvaloniaEdit.xaml" />
			<StyleInclude x:Key="DataGridFluent" Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
			<StyleInclude x:Key="DataGridSimple" Source="avares://Avalonia.Controls.DataGrid/Themes/Simple.xaml"/>
			<StyleInclude x:Key="ConfigFactoryFluent" Source="avares://ConfigFactory.Avalonia/Themes/Fluent/ConfigFactory.Avalonia.axaml" />
			<!-- must not be set in SimpleTheme: no simple theme for ConfigFactory -->
			<!--StyleInclude x:Key="ConfigFactorySimple" Source="avares://ConfigFactory.Avalonia/Themes/Simple/ConfigFactory.Avalonia.axaml" /-->
			<!-- Not clear if the both themes should be added here -->
			<FluentTheme x:Key="FluentTheme" />
			<SimpleTheme x:Key="SimpleTheme" />
		</ResourceDictionary>
	</Application.Resources>
	<Application.Styles>
		<StyleInclude Source="avares://ShowMeTheXaml.Avalonia/XamlDisplay.xaml"/>
		<StyleInclude Source="avares://AsyncImageLoader.Avalonia/AdvancedImage.axaml" />
		<Style Selector="DockControl">
			<Setter Property="(ControlRecyclingDataTemplate.ControlRecycling)" Value="{StaticResource ControlRecyclingKey}" />
		</Style>
		<Style Selector="DocumentControl">
			<Setter Property="IconTemplate">
				<DataTemplate DataType="core:IDockable">
					<PathIcon
					  Data="M5 1C3.89543 1 3 1.89543 3 3V13C3 14.1046 3.89543 15 5 15H11C12.1046 15 13 14.1046 13 13V5.41421C13 5.01639 12.842 4.63486 12.5607 4.35355L9.64645 1.43934C9.36514 1.15804 8.98361 1 8.58579 1H5ZM4 3C4 2.44772 4.44772 2 5 2H8V4.5C8 5.32843 8.67157 6 9.5 6H12V13C12 13.5523 11.5523 14 11 14H5C4.44772 14 4 13.5523 4 13V3ZM11.7929 5H9.5C9.22386 5 9 4.77614 9 4.5V2.20711L11.7929 5Z"
					  Width="16"
					  Height="16"
					  Margin="0"
					  Padding="0,0,2,0" />
				</DataTemplate>
			</Setter>
		</Style>
		<Style Selector="DocumentControl">
			<Setter Property="HeaderTemplate">
				<DataTemplate DataType="core:IDockable">
					<TextBlock Text="{Binding Title}"
							   VerticalAlignment="Center"
							   Padding="2"  />
				</DataTemplate>
			</Setter>
		</Style>
		<Style Selector="ToolControl">
			<Setter Property="HeaderTemplate">
				<DataTemplate DataType="core:IDockable">
					<TextBlock Text="{Binding Title}" Padding="2" />
				</DataTemplate>
			</Setter>
		</Style>
		<Style Selector="ToolChromeControl">
			<Setter Property="Background" Value="Transparent" />
		</Style>
	</Application.Styles>
</Application>
